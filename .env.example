# ── LUXE environment configuration ──────────────────────────────
# All variables are OPTIONAL. The application deploys and runs with
# none of them set — sensible secure defaults are generated at boot.

# Initial admin dashboard password (min 8 chars).
# If unset, a random password is generated and printed ONCE in the
# server log on first boot, and a forced password change is required.
# ADMIN_PASSWORD=

# 32-byte key (64 hex chars) used to encrypt the Telegram bot token
# at rest. If unset, a key file is auto-generated inside /data —
# setting this explicitly is recommended when a volume is attached.
# ENCRYPTION_KEY=

# Override the data directory (SQLite DB + uploads + secrets).
# Defaults to /data on Railway, ./data elsewhere.
# DATA_DIR=

# Canonical public URL (used for SEO metadata, sitemap, Open Graph).
# On Railway this is derived automatically from the public domain.
# NEXT_PUBLIC_SITE_URL=
